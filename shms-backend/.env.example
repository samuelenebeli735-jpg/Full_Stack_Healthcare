PORT=5000
# Interface to listen on. Default 127.0.0.1 (local only). Containers and
# servers reached over the network need HOST=0.0.0.0.
HOST=127.0.0.1
# Clinic wall-clock time zone. Scheduling, check-in and "today" use the
# server's local time, so it must match the clinic (UTC hosts are 1h off).
TZ=Africa/Lagos

NODE_ENV=development

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Use 127.0.0.1 rather than localhost: on some local stacks (Prisma/Node 24
# on Windows resolves localhost to ::1 first and can hang connecting).
#
# The application must connect as the shms_app role (non-superuser, no
# rolbypassrls) so PostgreSQL Row Level Security is actually enforced. A
# superuser/owner connection disables the policies. Apply role changes with
# the admin connection only (e.g. ALTER ROLE shms_app WITH LOGIN PASSWORD ...).
DATABASE_URL=postgresql://shms_app:app_password_here@127.0.0.1:5432/shms_db

FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Email provider endpoint (JSON POST of {to, subject, text, html}). While it is
# empty no email is sent and "forgot password" answers that reset by email is
# not available, instead of pretending a link was sent.
EMAIL_WEBHOOK_URL=

# Reverse proxy: how many proxy hops Express should trust when reading the
# client IP (rate limiting, audit). Leave empty when clients connect directly;
# use 1 behind a single proxy such as nginx or a Docker ingress.
TRUST_PROXY=

# Rate limits (per 15 minutes). API traffic is counted per signed-in user
# (anonymous traffic per client IP); sign-in counts only FAILED attempts per
# (client IP, account); registration is per client IP.
API_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=30
