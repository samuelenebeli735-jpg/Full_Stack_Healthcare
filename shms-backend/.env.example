PORT=5000

NODE_ENV=development

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

DATABASE_URL=postgresql://user:password@localhost:5432/shms_db

# Optional: owner/pg_dump-capable connection for the backup job.
# If empty, jobs/backup.js falls back to DATABASE_URL (which will fail for
# the RLS-restricted application role — backups need an owner/bostgres role).
BACKUP_DATABASE_URL=

FRONTEND_URL=http://localhost:5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
EMAIL_WEBHOOK_URL=

# Optional: enable distributed (multi-instance) rate limiting & risk tracking.
# Leave empty for a single instance to keep the in-memory fallback.
REDIS_URL=redis://127.0.0.1:6379
